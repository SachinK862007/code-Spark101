# Copy this file to backend/.env and fill in the values you have.
# NEVER commit backend/.env.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./urja.db

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Programmable Search (Custom Search JSON API).
# Create a Programmable Search Engine limited to gov.in style sources, then
# enable "Custom Search API" in Google Cloud and create an API key.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Absolute path to a Google Cloud service-account JSON file with the
# Speech-to-Text and Text-to-Speech APIs enabled.
GOOGLE_APPLICATION_CREDENTIALS=

# OpenWeatherMap — server-side only. Free plan covers current weather + 5 day/3 hour forecast.
OPENWEATHER_API_KEY=

LOG_LEVEL=INFO
